
flowchart TB
    subgraph INPUT["INPUT SENSORS"]
        A["MPU6050 - Right Upper Arm<br/>TCA Channel 2"]
        B["MPU6050 - Right Wrist<br/>TCA Channel 3"]
        C["MPU6050 - Left Upper Arm<br/>TCA Channel 4"]
        D["MPU6050 - Left Wrist<br/>TCA Channel 5"]
        E["HC-SR04<br/>Ultrasonic Distance Sensor"]
    end

    subgraph PROCESSING["PROCESSING UNIT"]
        F["TCA9548A<br/>I2C Multiplexer"]
        G["ESP32 Microcontroller"]
        H["Sensor Data Processing<br/>Smoothing and Angle Calculation"]
        I["BLE Data Packet Generation"]
    end

    subgraph OUTPUT["OUTPUT"]
        J["Bluetooth Low Energy"]
        K["Web Dashboard<br/>HTML, CSS and JavaScript"]
        L["Live Sensor Readings<br/>Calibration and Reference Recording"]
        M["Push-up Repetition Counting<br/>Posture Feedback"]
    end

    A --> F
    B --> F
    C --> F
    D --> F
    F -->|I2C| G
    E -->|Distance Measurement| G
    G --> H
    H --> I
    I --> J
    J -->|Wireless Data| K
    K --> L
    L --> M

    style INPUT fill:#DCEBFA,stroke:#3978B9,color:#172B42
    style PROCESSING fill:#E4F2E5,stroke:#438A4A,color:#17351B
    style OUTPUT fill:#F8E8D8,stroke:#C17A36,color:#49301A
